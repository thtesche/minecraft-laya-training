# Example environment for minecraft-laya-training.
#
# Copy to .env (gitignored) and fill in the values:  cp .env.example .env
# Loaded automatically on every CLI run; real environment variables take precedence.

# System 2 (OpenRouter): only needed for rare escalation / offline knowledge.
# Without it the agent still runs; escalation is simply skipped.
OPENROUTER_API_KEY=

# Register a fine-tuned Laya checkpoint (M3). A name matching a built-in re-points it,
# so the loop serves the fine-tune under `english` with no code change.
# LAYA_EXTRA_MODELS={"english": "/abs/path/to/runs/checkpoints/minecraft-<time>"}
