# Example environment for minecraft-laya-training.
#
# Copy to .env (gitignored) and fill in the values:  cp .env.example .env
# Loaded automatically on every CLI run; real environment variables take precedence.

# System 2 (Strata, local llama.cpp server at 192.168.0.109:8080): only needed for rare
# escalation / offline knowledge. Without it the agent still runs; escalation is skipped.
STRATA_API_KEY=

# Judge for the offline teacher path (`mlaya teacher`): OpenRouter's free Nemotron 3.5 Super VL
# (model nvidia/nemotron-3.5-super-vl:free, https://openrouter.ai/api/v1). A genuinely independent
# model from the Strata System 2, so it does not grade its own opinion. Without this key the judge
# returns "unsure" and the teacher path still runs. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Register a fine-tuned Laya checkpoint (M3). A name matching a built-in re-points it,
# so the loop serves the fine-tune under `english` with no code change.
# LAYA_EXTRA_MODELS={"english": "/abs/path/to/runs/checkpoints/minecraft-<time>"}
